options:
  parameters:
    author: Muthanna Alwahash
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: (c) 2026
    description: File Stereo FM receiver and RDS Decoder
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: file_FM_RDS_RX
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: File Stereo FM receiver and RDS Decoder
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12.0]
    rotation: 0
    state: enabled

blocks:
- name: CSA_freq
  id: variable
  parameters:
    comment: ''
    value: '76000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 216.0]
    rotation: 0
    state: enabled
- name: Ch_LPF_taps
  id: variable_low_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: 135e3
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: 1e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 8.0]
    rotation: 0
    state: enabled
- name: LO_freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1, 0,1, 100
    label: LO Freq.
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: cent_freq-(samp_rate/2/1e6)
    step: '0.1'
    stop: cent_freq+(samp_rate/2/1e6)
    value: '97.3'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 8.0]
    rotation: 0
    state: true

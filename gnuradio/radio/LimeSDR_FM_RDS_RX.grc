options:
  parameters:
    author: Muthanna Alwahash
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: (c) 2026
    description: LimeSDR Stereo FM receiver and RDS Decoder
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: LimeSDR_FM_RDS_RX
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LimeSDR Stereo FM receiver and RDS Decoder
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12.0]
    rotation: 0
    state: enabled

blocks:
- name: LO_freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0, 0,1, 100
    label: LO Freq.
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '87'
    step: '0.1'
    stop: '108'
    value: '92.6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 16.0]
    rotation: 0
    state: true
- name: NCO_offset
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1, 0,1, 100
    label: NCO Offset
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: -samp_rate/2
    step: 100e3
    stop: samp_rate/2
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 16.0]
    rotation: 0
    state: true
- name: baseband_Y_max
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,200,2,1
    label: '"Max"'
    min_len: '200'
    orient: QtCore.Qt.Vertical
    rangeType: int
    start: '-60'
    step: '10'
    stop: '10'
    value: '0'
    widget: slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1376, 16.0]
    rotation: 0
    state: enabled
- name: baseband_Y_min
